# .env.prod.example
#
# EC2 운영 배포용 환경변수 템플릿.
# 사용법:
#   cp .env.prod.example .env.prod
#   # .env.prod 에 실제 값을 채워 넣으세요.
#   # .env.prod 는 .gitignore 에 등록되어 있어 절대 커밋되지 않습니다.
#
# Docker Compose 실행:
#   docker compose -f docker-compose.prod.yml up -d
#
# 값이 필요한 외부 서비스:
#   - Google Cloud Console: OAuth Client ID / Secret
#   - OpenAI Platform: API Key
#   - AWS SES: 이메일 발송 (EMAIL_MODE=ses 전환 후 필요)
#   - EC2 배포 도메인 확정 후: GOOGLE_REDIRECT_URI, FRONTEND_BASE_URL

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=briefy
MYSQL_USER=briefy
MYSQL_PASSWORD=change-me-db-password

# ── Spring Boot ───────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# Docker Compose 내부 서비스명을 그대로 사용 (변경 불필요)
MYSQL_URL=jdbc:mysql://mysql:3306/briefy?useSSL=false&allowPublicKeyRetrieval=true
REDIS_HOST=redis
REDIS_PORT=6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# 최소 32자 이상의 랜덤 문자열 (예: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-32-char-minimum-secret
JWT_EXPIRATION_SECONDS=86400

# ── Frontend / CORS ───────────────────────────────────────────────────────────
# Vercel 배포 도메인 (예: https://briefy.vercel.app 또는 커스텀 도메인)
# SecurityConfig의 CORS allowedOrigins와 OAuth 콜백 리다이렉트에 사용됩니다.
FRONTEND_BASE_URL=https://app.example.com

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials 에서 발급
# Authorized redirect URI에 아래 GOOGLE_REDIRECT_URI 값을 등록해야 합니다.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-change-me
# EC2/Nginx를 통해 외부에 노출되는 백엔드 도메인 기준으로 설정
# (예: https://api.example.com/api/oauth2/callback/google)
GOOGLE_REDIRECT_URI=https://api.example.com/api/oauth2/callback/google

# ── Scheduler ────────────────────────────────────────────────────────────────
# 초기 배포에서는 false 권장. 안정화 후 true로 전환.
SCHEDULER_ENABLED=false
# 기본값(Asia/Seoul 06:00)을 그대로 사용하려면 아래 두 줄을 주석 처리하세요.
DAILY_COLLECTION_CRON=0 0 6 * * *
DAILY_BRIEFING_CRON=0 0 8 * * *

# ── Email ────────────────────────────────────────────────────────────────────
# 초기 배포 안전값: log (파일/로그 출력만, 실제 발송 없음)
# SES 준비 완료 후: ses 로 변경
EMAIL_MODE=log
EMAIL_AUTO_SEND_ENABLED=false
# EMAIL_MODE=ses 전환 후 아래 값 설정 필요
SES_FROM_EMAIL=no-reply@example.com
AWS_REGION=ap-northeast-2

# ── AWS Credentials (SES 사용 시) ────────────────────────────────────────────
# EC2 IAM Role을 사용한다면 아래 두 줄 불필요 (주석 처리 권장)
AWS_ACCESS_KEY_ID=AKIACHANGE-ME
AWS_SECRET_ACCESS_KEY=change-me-aws-secret

# ── Inter-service URLs ────────────────────────────────────────────────────────
# Docker Compose 내부 서비스명을 그대로 사용 (변경 불필요)
AGENT_URL=http://agent:8000
BACKEND_URL=http://backend:8080

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-change-me

# ── Agent: LLM ───────────────────────────────────────────────────────────────
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30

# ── Agent: Job Collection ─────────────────────────────────────────────────────
# 초기 배포 안전값: fixture 비활성화, 실제 수집도 비활성화
JOB_COLLECTION_USE_FIXTURE=false
JOB_COLLECTION_ENABLE_REAL_SOURCES=false
JOB_COLLECTION_ENABLE_SARAMIN=false
JOB_COLLECTION_TIMEOUT_SECONDS=10

# ── Agent: Saramin API ────────────────────────────────────────────────────────
# JOB_COLLECTION_ENABLE_SARAMIN=true 설정 시 필수
SARAMIN_ACCESS_KEY=change-me-saramin-key
