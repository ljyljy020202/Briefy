# Copy this file to .env and fill in real values before running 'make dev'.
# The .env file is gitignored and never committed.

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=briefy
MYSQL_PASSWORD=briefypassword

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Spring Boot ───────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Register at https://console.cloud.google.com/ -> APIs & Services -> Credentials
# Authorized redirect URI to register: http://localhost:8080/api/oauth2/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/oauth2/callback/google

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters (256 bits) for HS256.
JWT_SECRET=change-me-to-a-random-32-char-minimum-secret
JWT_EXPIRATION_SECONDS=86400
JWT_COOKIE_NAME=briefy_access_token
# Local: false. Production: true (requires HTTPS).
JWT_COOKIE_SECURE=false
# Local: Lax. Production cross-domain: None (requires Secure=true).
JWT_COOKIE_SAME_SITE=Lax

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:3000

# ── Agent (Python) ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# Renamed from NEXT_PUBLIC_API_URL to match api.md spec
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_AGENT_URL=http://localhost:8000

# ── Inter-service (used inside Docker network) ───────────────────────────────
AGENT_URL=http://agent:8000
BACKEND_URL=http://backend:8080
