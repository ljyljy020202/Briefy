# Copy this file to .env and fill in real values before running 'make dev'.
# The .env file is gitignored and never committed.

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=briefy
MYSQL_PASSWORD=briefypassword

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Spring Boot ───────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local
JWT_SECRET=change-me-32-chars-minimum-in-production

# ── Agent (Python) ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AGENT_URL=http://localhost:8000

# ── Inter-service (used inside Docker network) ───────────────────────────────
AGENT_URL=http://agent:8000
BACKEND_URL=http://backend:8080
