# Copy this file to .env and fill in real values before running 'make dev'.
# The .env file is gitignored and never committed.
#
# This single file is the source of truth for ALL services:
#   - Docker Compose ('make dev') reads it directly.
#   - Native development (poetry run, bootRun) also reads it.
# Docker Compose hardcodes inter-service hostnames in docker-compose.yml,
# so BACKEND_URL / AGENT_URL here apply only to native runs.

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=briefy
MYSQL_PASSWORD=briefypassword

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Spring Boot ───────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Register at https://console.cloud.google.com/ -> APIs & Services -> Credentials
# Authorized redirect URI to register: http://localhost:8080/api/oauth2/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/oauth2/callback/google

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters (256 bits) for HS256.
JWT_SECRET=change-me-to-a-random-32-char-minimum-secret
JWT_EXPIRATION_SECONDS=86400
JWT_COOKIE_NAME=briefy_access_token
# Local: false. Production: true (requires HTTPS).
JWT_COOKIE_SECURE=false
# Local: Lax. Production cross-domain: None (requires Secure=true).
JWT_COOKIE_SAME_SITE=Lax

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Agent: Job Collection ─────────────────────────────────────────────────────
# true: fixture 데이터 반환 (로컬 개발 / CI 기본값)
JOB_COLLECTION_USE_FIXTURE=false
# true: 실제 외부 소스 수집 활성화 (프로덕션에서만 opt-in)
JOB_COLLECTION_ENABLE_REAL_SOURCES=false
# 소스별 HTTP 타임아웃 (초)
JOB_COLLECTION_TIMEOUT_SECONDS=10
# JASOSEOL_BASE_URL=https://jasoseol.com

# ── Agent: LLM ────────────────────────────────────────────────────────────────
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30

# ── Inter-service URLs (native development only) ─────────────────────────────
# Docker Compose hardcodes Docker-internal hostnames; these values apply only
# when running services natively (e.g. poetry run, ./gradlew bootRun).
AGENT_URL=http://localhost:8000
BACKEND_URL=http://localhost:8080
