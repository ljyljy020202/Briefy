# Native development only — for 'poetry run uvicorn ...'
# Docker Compose reads from the root .env instead; do not use this file for Docker runs.
#
# Setup:
#   cp apps/agent/.env.example apps/agent/.env
#   # Fill in real values, especially OPENAI_API_KEY
#
# apps/agent/.env is gitignored and must never be committed.

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Backend ──────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8080

# ── Job Collection ───────────────────────────────────────────────────────────
# true  → fixture 데이터 반환 (테스트용)
# false → 실제 외부 소스 수집 (로컬에서 실제 동작 확인 시)
JOB_COLLECTION_USE_FIXTURE=false
# true  → 실제 외부 소스 활성화 (프로덕션에서만 opt-in)
JOB_COLLECTION_ENABLE_REAL_SOURCES=false
JOB_COLLECTION_TIMEOUT_SECONDS=10
# JASOSEOL_BASE_URL=https://jasoseol.com

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
